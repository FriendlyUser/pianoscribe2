# PianoScribe configuration. Copy to `.env` and adjust; every value is optional.
# Variables prefixed PS_ are read by the API, worker and janitor (see backend/app/config.py).

# --- Deployment ------------------------------------------------------------
PS_WEB_PORT=8080            # host port for the web UI
PS_WEB_BIND=127.0.0.1       # host interface; 0.0.0.0 exposes the UI to your network (there is no login)
PS_WORKER_PROCESSES=1       # parallel jobs per worker container; keep 1 per GPU
PS_WORKER_MEMORY=12g        # memory ceiling for the worker container
PS_LOG_LEVEL=INFO
PS_LOG_FORMAT=json          # json | console

# --- Ingestion limits ------------------------------------------------------
PS_MAX_UPLOAD_MB=200
PS_MAX_DURATION_SECONDS=600
PS_YOUTUBE_ENABLED=true
PS_YOUTUBE_TIMEOUT_SECONDS=300
PS_YOUTUBE_MAX_ATTEMPTS=3
PS_YOUTUBE_BACKOFF_BASE_SECONDS=2
PS_YOUTUBE_MAX_FILESIZE_MB=400

# --- Sandbox for ffmpeg / ffprobe / yt-dlp ---------------------------------
PS_FFMPEG_TIMEOUT_SECONDS=300
PS_SANDBOX_MEMORY_MB=2048
PS_SANDBOX_CPU_SECONDS=900
PS_SANDBOX_MAX_FILE_MB=2048

# --- Jobs ------------------------------------------------------------------
PS_JOB_MAX_RETRIES=2                    # retries before a job is dead-lettered
PS_JOB_TIME_LIMIT_SECONDS=3600
PS_JOB_LOCK_TTL_SECONDS=60
PS_QUEUE_HEARTBEAT_TIMEOUT_SECONDS=45   # silent worker => its jobs are re-queued

# --- Retention -------------------------------------------------------------
PS_RAW_RETENTION_SECONDS=3600           # backstop purge of raw uploads / work files
PS_RESULT_RETENTION_SECONDS=604800      # finished scores (and their cache entries)
PS_JANITOR_INTERVAL_SECONDS=300

# --- Models ----------------------------------------------------------------
PS_MODEL_DEVICE=auto                    # auto | cuda | cpu
PS_TSUMUGI_WINDOW_BATCH_SIZE=2          # transcription batch size; 2 fits an 8 GB card
PS_TRANSCRIBE_TIMEOUT_SECONDS=2400
PS_ARRANGE_TIMEOUT_SECONDS=1800
PS_NOTATE_TIMEOUT_SECONDS=1800

# --- Arrangement (songs) ---------------------------------------------------
PS_COVER_SOURCE_CFG=2.0                 # how closely the arrangement follows the original (higher: closer)
PS_COVER_ONSET_BIAS=4.0                 # pull note onsets toward onsets in the original
PS_COVER_DENSITY=1.0                    # note density
PS_COVER_DYNAMICS=1.0
PS_COVER_TEMPERATURE=1.0
PS_COVER_TOP_P=0.9
PS_COVER_SEED=0                         # arrangements are sampled; a fixed seed makes them repeatable
PS_COVER_CANDIDATES=1                   # covers generated per song (the one closest to the melody is kept)
PS_COVER_OPENING_MIN_FIDELITY=0.8       # an opening that plays less of the detected melody is generated again
PS_COVER_OPENING_RETRIES=2
PS_ANALYSIS_MEMORY_FRACTION=0.95        # GPU memory share for the beat and key models
PS_SOLO_SECTION_BARS=64                 # solo pieces longer than this are written in sections (0: off)

# --- Output ----------------------------------------------------------------
PS_VIDEO_SCORE_WRITER=exact             # piano videos: exact (written by rule, as read) | model (the score model)
PS_VISUAL_MAX_WIDTH=1920                # piano videos are read at most this wide
PS_YOUTUBE_VIDEO_HEIGHT=1080            # largest picture fetched for a YouTube piano video
PS_PAGE_SIZE=A4                         # A4 | Letter
